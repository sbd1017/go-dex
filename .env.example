# godex settings (environment variables). Defaults in brackets.
DEX_BASE_PATH=/dex            # URL prefix ('/' to serve at the root)  [/dex]
DEX_AUTH=password             # password | site | none  [password]
                              # none: anyone can edit. For local development, or a public demo that resets itself;
                              # it only listens on 127.0.0.1, so put it behind a reverse proxy
DEX_DATA_DIR=./var            # database, secret key, backups  [./var]
DEX_SPRITES_DIR=./media/sprites   # your Pokémon images  [./media/sprites]
DEX_HOST=127.0.0.1
DEX_PORT=8782
DEX_SECURE_COOKIES=1          # set 0 only for plain-http local testing
# DEX_ADMIN_PASSWORD_HASH=    # alternative to `python -m godex.cli set-password`
# DEX_PUBLIC_ORIGINS=https://example.com   # extra allowed Origins for admin POSTs, if your proxy rewrites Host
