# Copy to deploy.env (not committed) and fill in. Used by scripts/deploy.sh.
DEPLOY_HOST=myserver                         # ssh host alias
APP_DIR=/srv/godex                           # where the code lives on the server
APP_USER=godex                               # system user the service runs as
SERVICE=godex                                # systemd unit name
PORT=8782
BASE_PATH=/dex
AUTH=site                                    # site (reverse-proxy login) or password
NGINX_LOCATIONS=/etc/nginx/snippets/godex.conf
NGINX_HTTP=/etc/nginx/conf.d/20-godex.conf
IDENTITY_INCLUDE=snippets/site-identity.conf # snippet that sets X-Site-User/CSRF/Expires after auth_request
LOG_FORMAT=combined
